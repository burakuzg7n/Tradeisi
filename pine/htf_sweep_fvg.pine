//@version=5
// TradeBot — HTF Bias + Liquidity Sweep + FVG Retest
// Python referansı: tradebot/strategy.py (birebir aynı kurallar)
// Anti-repaint: barstate.isconfirmed + security(ifade[1], lookahead_off)
indicator("TradeBot HTF Sweep FVG", overlay=true, max_boxes_count=100, max_lines_count=100)

// ================= Inputs =================
htfTf          = input.timeframe("240", "HTF (bias)")
htfPivot       = input.int(3,  "HTF pivot (sol/sağ)", minval=1)
ltfPivot       = input.int(10, "LTF pivot (sol/sağ)", minval=2)
fvgMinSizePct  = input.float(0.05, "Min FVG boyutu %", step=0.01) / 100
minRiskPct     = input.float(0.2,  "Min stop mesafesi %", step=0.05) / 100
rrTarget       = input.float(2.0,  "RR hedefi", step=0.5)
stopBufferPct  = input.float(0.1,  "Stop tamponu %", step=0.05) / 100
setupWindow    = input.int(24, "Sweep→FVG penceresi (bar)")
useSessionFilt = input.bool(true, "Killzone filtresi (London 07-10, NY 13-16 UTC)")
useVolFilter   = input.bool(false, "Volume konfirmasyonu (sweep hacmi >= 1.5x MA20)")
volSpikeMult   = input.float(1.5, "Hacim spike carpani", step=0.1)
volMaWindow    = input.int(20, "Hacim MA penceresi")

// ================= HTF Bias =================
// Pivot kesinleşmesi Pine'da doğaldır: ta.pivothigh ancak sağ N bar sonra değer döner.
f_trend() =>
    ph = ta.pivothigh(high, htfPivot, htfPivot)
    pl = ta.pivotlow(low, htfPivot, htfPivot)
    var float lastSH = na
    var float lastSL = na
    var int   trend  = 0
    if not na(ph)
        lastSH := ph
    if not na(pl)
        lastSL := pl
    if not na(lastSH) and close > lastSH
        trend  := 1
        lastSH := na       // aynı seviye tekrar tetiklenmesin
    if not na(lastSL) and close < lastSL
        trend  := -1
        lastSL := na
    trend

// [1] + lookahead_off → yalnızca KAPANMIŞ 4H mumunun bias'ı (repaint yok)
htfBias = request.security(syminfo.tickerid, htfTf, f_trend()[1], lookahead=barmerge.lookahead_off)

// ================= Session (UTC) =================
utcHour = hour(time, "UTC")
inKillzone = (utcHour >= 7 and utcHour < 10) or (utcHour >= 13 and utcHour < 16)

// ================= LTF likidite seviyeleri =================
ph = ta.pivothigh(high, ltfPivot, ltfPivot)
pl = ta.pivotlow(low, ltfPivot, ltfPivot)
var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

// ================= Sweep durumu =================
var int   sweepDir     = 0
var int   sweepBar     = na
var float sweepExtreme = na
var float sweepLevel   = na

// Volume konfirmasyonu: kendi barı hariç geçmiş MA (lookahead yok)
volMa = ta.sma(volume, volMaWindow)[1]
volOK = not useVolFilter or (not na(volMa) and volume >= volSpikeMult * volMa)

if barstate.isconfirmed
    // pencere doldu / bias değişti → sıfırla
    if sweepDir != 0 and (bar_index - sweepBar > setupWindow or htfBias != sweepDir)
        sweepDir := 0

    // yeni sweep (yalnızca bias yönünde, hacim şartıyla)
    if htfBias == 1 and volOK and not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
        sweepDir     := 1
        sweepBar     := bar_index
        sweepExtreme := low
        sweepLevel   := lastSwingLow
        lastSwingLow := na
    if htfBias == -1 and volOK and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
        sweepDir      := -1
        sweepBar      := bar_index
        sweepExtreme  := high
        sweepLevel    := lastSwingHigh
        lastSwingHigh := na

// ================= FVG + setup =================
bullFVG = low > high[2] and (low - high[2]) / close[1] >= fvgMinSizePct
bearFVG = high < low[2] and (low[2] - high) / close[1] >= fvgMinSizePct

var float sigEntry  = na
var float sigStop   = na
var float sigTarget = na
newSignal = false

if barstate.isconfirmed and sweepDir != 0 and bar_index > sweepBar
    sessionOK = not useSessionFilt or inKillzone
    if sweepDir == 1 and bullFVG
        if not sessionOK
            sweepDir := 0
        else
            fvgTop = low
            fvgBot = high[2]
            entry  = fvgTop - (fvgTop - fvgBot) * 0.5        // %50 doluluk
            stop   = math.min(sweepExtreme, fvgBot) * (1 - stopBufferPct)
            risk   = entry - stop
            if risk > 0 and risk / entry >= minRiskPct
                sigEntry  := entry
                sigStop   := stop
                sigTarget := entry + rrTarget * risk
                newSignal := true
                box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBot, border_color=color.green, bgcolor=color.new(color.green, 85))
            sweepDir := 0
    if sweepDir == -1 and bearFVG
        if not sessionOK
            sweepDir := 0
        else
            fvgTop = low[2]
            fvgBot = high
            entry  = fvgBot + (fvgTop - fvgBot) * 0.5
            stop   = math.max(sweepExtreme, fvgTop) * (1 + stopBufferPct)
            risk   = stop - entry
            if risk > 0 and risk / entry >= minRiskPct
                sigEntry  := entry
                sigStop   := stop
                sigTarget := entry - rrTarget * risk
                newSignal := true
                box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBot, border_color=color.red, bgcolor=color.new(color.red, 85))
            sweepDir := 0

// ================= Görsel =================
plotshape(barstate.isconfirmed and sweepDir == 1 and bar_index == sweepBar, "SSL Sweep", shape.circle, location.belowbar, color.green, size=size.small)
plotshape(barstate.isconfirmed and sweepDir == -1 and bar_index == sweepBar, "BSL Sweep", shape.circle, location.abovebar, color.red, size=size.small)
plotshape(newSignal, "Setup", shape.labelup, location.belowbar, color.blue, size=size.normal)
bgcolor(useSessionFilt and inKillzone ? color.new(color.blue, 94) : na)

// ================= Webhook alert (JSON) =================
if newSignal
    dir = sigTarget > sigEntry ? "long" : "short"
    js = '{"symbol":"' + syminfo.ticker + '","direction":"' + dir +
         '","entry":' + str.tostring(sigEntry, format.mintick) +
         ',"stop_loss":' + str.tostring(sigStop, format.mintick) +
         ',"take_profit":' + str.tostring(sigTarget, format.mintick) +
         ',"setup":"ssl_sweep_fvg","timeframe":"' + timeframe.period +
         '","htf_bias":"' + (htfBias == 1 ? "bullish" : "bearish") +
         '","timestamp":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"}'
    alert(js, alert.freq_once_per_bar_close)
