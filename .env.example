# --- Borsa (demo icin Bybit testnet onerilir; KURULUM.md Adim 3-4) ---
EXCHANGE_ID=bybit
TRADING_MODE=testnet       # 'live' YAZMADAN ONCE: Strategy Bible bolum 8
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ACCOUNT_BALANCE=10000

# --- Kayit ---
JOURNAL_DB=journal.db

# --- Telegram bildirimleri (opsiyonel; KURULUM.md Adim 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook sunucusu (TradingView yolu kullanilirsa; demo icin gerekmez) ---
WEBHOOK_SECRET=degistir-bunu-uzun-rastgele-token
PAPER_MODE=1

# =====================================================================
#  YENI: `trader/` paketi (TradeBot - sepet momentum adayi)
#  Ayri bir dosya kullanmaniza gerek yok; asagidaki degiskenler
#  ayni .env dosyasinda durabilir. .env ASLA commit edilmez.
# =====================================================================

# --- Calisma modu ---
# paper   = gercek para YOK (varsayilan, guvenli)
# testnet = sahte para (borsanin testnet hesabi)
# live    = GERCEK PARA - sadece protokol kapilari gectikten sonra
TRADER_MODE=paper

# --- Paper / testnet / canli baslangic sermayesi (USDT) ---
INITIAL_EQUITY=1000

# --- Borsa (yukaridaki EXCHANGE_ID / API anahtarlari paylasilir) ---
MARKET_KIND=perp
DEFAULT_TYPE=swap
RECV_WINDOW_MS=20000

# --- Kayit (journal) dosyasi ---
TRADER_DB=out/trader.db

# --- Web paneli ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
